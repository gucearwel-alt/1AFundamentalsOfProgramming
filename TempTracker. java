‎// dito naman ay naglagay tayo ng mga value gamit ang index na laging nagsisismula sa 0
‎
‎        System.out.println("=== Mga Temperatura ===");
‎        for (int i = 0; i < temperatures.length; i++) {
‎            // Ipinakita natin rito ang araw at ang temperatura
‎            System.out.println("Araw " + (i + 1) + ": " + temperatures[i] + "°C");
‎        }   // dito naman ay gumamit tayo ng for loop upang maipakita ang lahat ng temperature
